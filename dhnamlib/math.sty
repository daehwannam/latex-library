% \newcommand{\setsize}[1]{\left \mid #1 \right \mid}  % not working
% \newcommand{\setsize}[1]{| #1 |}
% \newcommand{\setsize}[1]{\mid #1 \mid}
\newcommand{\setsize}[1]{\left\lvert #1\right\rvert}
\newcommand{\setmake}[1]{\left\{ #1\right\}}
\newcommand{\setunion}[2]{#1 \cup #2}
\newcommand{\setadd}[2]{\setunion{#1}{\setmake{#2}}}

% Independence
% https://tex.stackexchange.com/a/174134
\newcommand*{\centernot}{%
  \mathpalette\@centernot
}
\def\@centernot#1#2{%
  \mathrel{%
    \rlap{%
      \settowidth\dimen@{$\m@th#1{#2}$}%
      \kern.5\dimen@
      \settowidth\dimen@{$\m@th#1=$}%
      \kern-.5\dimen@
      $\m@th#1\not$%
    }%
    {#2}%
  }%
}
\makeatother

\newcommand{\independent}{\perp\mkern-9.5mu\perp}
\newcommand{\notindependent}{\centernot{\independent}}

% \toward
\newcommand{\toward}{\textrm{ to }}
\newcommand{\fromone}[1]{1 \toward #1}

% \ifoth
%
% Example: \(\ifoth{x}{condition}{y}\)  % Output: x if condition; otherwise, y
\newcommand{\ifoth}[3]{#1 \text{ if } #2; \text{ otherwise, } #3}
\newcommand{\caseifoth}[3]{\begin{cases}#2, & \text{if } #1 \\ #3, & \text{otherwise} \end{cases}}
\newcommand{\suchthat}[2]{#1 \text{ s.t. } #2}
\newcommand{\existsst}[2]{\exists \suchthat{#1}{#2}}
\newcommand{\nexistsst}[2]{\nexists \suchthat{#1}{#2}}

