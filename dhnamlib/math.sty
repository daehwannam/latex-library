\RequirePackage{amsmath}


% https://tex.stackexchange.com/a/5255
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}

% \argtop
%
% Example: \argtop{k}_{i \in {1,\dots,n}} f(i)
\newcommand{\argtop}[1]{\operatorname*{arg\,top-\mathit{#1}}}
\newcommand{\argtopl}[1]{\operatorname*{arg\,top-#1}\limits}

\newcommand{\maxl}{\max\limits}
\newcommand{\minl}{\min\limits}

